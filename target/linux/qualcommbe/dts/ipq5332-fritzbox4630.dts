/dts-v1/;

#include <arm64/qcom/ipq5332.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>

/ {
	model = "FRITZ! FRITZ!Box 4630";
	compatible = "fritz,fritzbox4630", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
		led-boot = &power;
		led-failsafe = &info_red;
		led-running = &power;
		led-upgrade = &info_red;
	};

	chosen {
		bootargs = "console=ttyMSM0,115200n8 clk_ignore_unused";
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

        	tzapp:tzapp@49600000 {  /* TZAPPS */
			reg = <0x0 0x49600000 0x0 0x00600000>;
			no-map;
		};

		m3_dump: m3-dump@4d400000 {
			reg = <0x0 0x4d400000 0x0 0x100000>;
			no-map;
		};

		q6_caldb: q6-caldb@4d500000 {
			reg = <0x0 0x4d500000 0x0 0x500000>;
			no-map;
		};

		mlo_mem: mlo-global-mem@4db00000 {
			reg = <0x0 0x4db00000 0x0 0x01200000>;
			no-map;
		};

		qcn9274_host_ddr: qcn9274-host-ddr@4ed00000 {
			reg = <0x0 0x4ed00000 0x0 0x03200000>;
			no-map;
		};
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-0 {
			label = "wlan";
			gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
		};

		button-1 {
			label = "dect";
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PHONE>;
		};

		button-2 {
			label = "wps";
			gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	usb_vbus_5v: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&tlmm 39 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		enable-active-high;
	};

	leds {
		compatible = "gpio-leds";

		power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
		};

		wlan {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
		};

		dect {
			function = "dect";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
		};

		wps {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 7 GPIO_ACTIVE_HIGH>;
		};

		info_red: info-red {
			function = "info";
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
		};

		info-green {
			function = "info";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 45 GPIO_ACTIVE_HIGH>;
		};
	};
};

&blsp1_uart0 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board {
	clock-frequency = <24000000>;
};

&usbphy0 {
	status = "okay";
};

&usb {
	status = "okay";

	dr_mode = "host";
};

&pcie0_phy {
	compatible = "qcom,ipq5332-uniphy-usb-ss-phy";

	clocks = <&gcc GCC_PCIE3X1_PHY_AHB_CLK>,
		 <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
		 <&gcc GCC_USB0_PIPE_CLK>;
	clock-names = "ahb", "cfg_ahb", "pipe";

	resets = <&gcc GCC_USB0_PHY_BCR>;

	vdd-supply = <&usb_vbus_5v>;

	status = "okay";
};

&mdio {
	status = "okay";
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio17", "gpio34", "gpio50";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	qspi_nand_pins: qspi_nand_pins {
		qspi_clock {
			pins = "gpio13";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-pull-down;
		};

		qspi_cs {
			pins = "gpio12";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-pull-up;
		};

		qspi_data {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "qspi_data";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "avm,nand_partitions","spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "urloader";
				reg = <0x00000000 0x600000>;
				read-only;
			};

			partition@1 {
				label = "nand-tffs";
				reg = <0x600000 0x800000>;
				read-only;
			};

			partition@2 {
				label = "fit0";
				reg = <0xe00000 0x800000>;
			};

			partition@3 {
				label = "fit1";
				reg = <0x1600000 0x800000>;
			};

			partition@4 {
				label = "ubi";
				reg = <0x1e00000 0xe200000>;
			};
		};
	};
};

&wifi0 {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt",
			"ath12k/IPQ5332/hw1.0/iu_fw.mdt";
	memory-region = <&q6_region>, <&m3_dump>, <&q6_caldb>, <&mlo_mem>;
	memory-region-names = "q6-region", "m3-dump", "q6-caldb", "mlo-global-mem";
	qcom,bdf-address-offset = <0x0c00000>;
	qcom,board-id = <18>;
	qcom,legacy-userpd-bootinfo;
	qcom,rproc = <&q6v5_wcss>;
	qcom,wsi-controller;
	status = "okay";
};

&q6v5_wcss {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw0.mdt";
	status = "okay";
};
