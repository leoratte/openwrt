/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "AVM FRITZ!Box 7510";
	compatible = "avm,fritzbox-7510", "qcom,ipq5018";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_red;
		led-running = &led_power;
		led-upgrade = &led_red;
		serial0 = &blsp1_uart1;
	};

	chosen {
		bootargs = "ubi.mtd=ubi root=/dev/ubiblock0_0 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-0 {
			label = "wlan";
			gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
		};

		button-1 {
			label = "dect";
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PHONE>;
		};

		button-2 {
			label = "wps";
			gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	reg_usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_red: led-info-red {
			function = "info";
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
		};

		led-info-green {
			function = "info";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
		};

		led-wps {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 39 GPIO_ACTIVE_HIGH>;
		};

		led-dect {
			function = "dect";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		};

		led-wlan {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
		};

		led_power: led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		};
	};
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
};

&gmac0 {
	status = "okay";
};

&uniphy0 {
	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;

	status = "okay";
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio16", "gpio17", "gpio19";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio10", "gpio13", "gpio36", "gpio37", "gpio39", "gpio46";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};
};

&usb {
	dr_mode = "host";

	phys = <&usbphy0>;
	phy-names = "usb2-phy";
	qcom,select-utmi-as-pipe-clk;

	status = "okay";
};

&usbphy0 {
	vdd-supply = <&reg_usb_vbus>;

	status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";

	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
//		nand-ecc-strength = <4>;
//		nand-ecc-step-size = <512>;
//		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "urlader";
				reg = <0x00000000 0x540000>;
				read-only;
			};

			partition@1 {
				label = "nand-tffs";
				reg = <0x540000 0x800000>;
				read-only;
			};

			partition@2 {
				label = "fit0";
				reg = <0xd40000 0x800000>;
			};

			partition@3 {
				label = "fit1";
				reg = <0x1540000 0x800000>;
			};

			partition@4 {
				label = "ubi";
				reg = <0x1d40000 0x62c0000>;
			};
		};
	};
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&pwm {
	status = "okay";
};

&q6v5_wcss {
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";
};

&wifi {
	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "AVM-FritzBox7510";
	qcom,ath11k-fw-memory-mode = <1>;

	status = "okay";
};
