/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt65xx.h>

#include "mt7986a.dtsi"

/ {
	compatible = "tplink,er7412-m2", "mediatek,mt7986a";
	model = "TP-Link ER7412-M2";

	aliases {
		serial0 = &uart0;
	};

        chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		reg = <0 0x40000000 0 0x40000000>;
		device_type = "memory";
        };

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		led-sys {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 10 GPIO_ACTIVE_LOW>;
		};

		led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 11 GPIO_ACTIVE_LOW>;
		};

		led-usb {
			function = LED_FUNCTION_USB;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 14 GPIO_ACTIVE_LOW>;
		};

		led-sfp0 {
			label = "sfp_led_0";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};

		led-sfp1 {
			label = "sfp_led_1";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 2 GPIO_ACTIVE_LOW>;
		};
	};
};

&crypto {
	status = "okay";
};

&eth {
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";

		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "2500base-x";

		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;
	};

};

&mdio {
	phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <1>;
		realtek,aldps-enable;
	};

	phy2: phy@2 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <2>;
		realtek,aldps-enable;
	};

	switch0: switch@1f {
		compatible = "mediatek,mt7531";
		reg = <31>;
		reset-gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&pio>;
		interrupts = <66 IRQ_TYPE_LEVEL_HIGH>;
	};

	switch1: switch@1e {
		compatible = "mediatek,mt7531";
		reg = <30>;
		reset-gpios = <&pio 15 GPIO_ACTIVE_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&pio>;
		interrupts = <23 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&switch0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			label = "port3";
		};

		port@1 {
			reg = <1>;
			label = "port4";
		};

		port@2 {
			reg = <2>;
			label = "port5";
		};

		port@3 {
			reg = <3>;
			label = "port6";
		};

		port@4 {
			reg = <4>;
			label = "port7";
		};

		port@5 {
			reg = <5>;
			label = "port1";
			phy-handle = <&phy1>;
			phy-mode = "2500base-x";
		};

		port@6 {
			reg = <6>;
			ethernet = <&gmac0>;
			phy-mode = "2500base-x";

			fixed-link {
				speed = <2500>;
				full-duplex;
				pause;
			};
		};
	};
};

&switch1 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			label = "port8";
		};

		port@1 {
			reg = <1>;
			label = "port9";
		};

		port@2 {
			reg = <2>;
			label = "port10";
		};

		port@3 {
			reg = <3>;
			label = "port11";
		};

		port@4 {
			reg = <4>;
			label = "port12";
		};

		port@5 {
			reg = <5>;
			label = "port2";
			phy-handle = <&phy2>;
			phy-mode = "2500base-x";
		};

		port@6 {
			reg = <6>;
			ethernet = <&gmac1>;
			phy-mode = "2500base-x";

			fixed-link {
				speed = <2500>;
				full-duplex;
				pause;
			};
		};
	};
};

&pio {
	spi_flash_pins: spi-flash-pins-33-to-38 {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};
		conf-pu {
			pins = "SPI2_CS", "SPI2_HOLD", "SPI2_WP";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-disable; /* bias-disable */
		};
		conf-pd {
			pins = "SPI2_CLK", "SPI2_MOSI", "SPI2_MISO";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-disable; /* bias-disable */
		};
	};
};

&spi0 {
	pinctrl-names = "default";
        pinctrl-0 = <&spi_flash_pins>;
        status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;

		spi-max-frequency = <52000000>;
		spi-tx-buswidth = <4>;
		spi-rx-buswidth = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x0000000 0x0100000>;
				read-only;
			};

			partition@100000 {
				label = "u-boot-env";
				reg = <0x0100000 0x0080000>;
			};

			partition@180000 {
				label = "Factory";
				reg = <0x0180000 0x0200000>;
				read-only;
			};

			partition@380000 {
				label = "FIP";
				reg = <0x0380000 0x0200000>;
				read-only;
			};

			partition@580000 {
				label = "ubi";
				reg = <0x0580000 0x7280000>;
				compatible = "linux,ubi";

				volumes {
					ubi_rootdisk: ubi-volume-fit {
						volname = "fit";
					};
				};
			};
		};
	};
};

&trng {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&ssusb {
	status = "okay";
};

&watchdog {
	status = "okay";
};
